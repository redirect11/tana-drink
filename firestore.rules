rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // DRINKS — lettura pubblica (clienti vedono il menù), scrittura solo bartender autenticato.
    match /drinks/{drinkId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ORDERS — i clienti creano e leggono; il bartender (autenticato) aggiorna
    // qualsiasi cosa. Il cliente (non autenticato, in possesso dell'id ordine)
    // può modificare o annullare l'ordine SOLO finché è "ricevuto" (prima della
    // preparazione): può lasciarlo "ricevuto" (modifica item) o portarlo a
    // "annullato". Non può farlo avanzare di stato.
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if request.auth != null
        || (resource.data.status == 'ricevuto'
            && request.resource.data.status in ['ricevuto', 'annullato']);
      allow delete: if false;
    }

    // COUNTERS — scritti dalla transazione di creazione ordine (lato client, non autenticato).
    match /counters/{dateKey} {
      allow read: if true;
      allow write: if true;
    }

    // SERATE — lettura pubblica (il cliente deve sapere se è aperta), apri/chiudi solo bartender.
    match /serate/{serataId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // CATEGORIES — lettura pubblica (il menù raggruppa per categoria), scrittura bartender.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // INVENTORY — solo bartender autenticato (non serve al cliente, resta privato).
    match /inventory_items/{itemId} {
      allow read, write: if request.auth != null;
    }

    // STOCK MOVEMENTS — registro carico/scarico, solo bartender autenticato.
    match /stock_movements/{movementId} {
      allow read, write: if request.auth != null;
    }
  }
}
