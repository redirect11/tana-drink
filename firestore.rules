rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Ruoli ─────────────────────────────────────────────────────────
    // Il ruolo vive nei custom claims del token ("role"): 'admin',
    // 'bartender' o 'staff', assegnati esplicitamente dall'admin. Gli
    // account SENZA claim sono CLIENTI registrati (nessun privilegio
    // gestionale). Lo staff può SOLO segnare come serviti gli ordini pronti.
    //
    // isBartender() vale anche per l'admin: le due figure hanno lo stesso
    // accesso ai dati, l'admin in più nomina i ruoli — e quello non passa
    // da qui, ma dalla callable staffAdmin (Admin SDK).
    function isSignedIn() {
      return request.auth != null;
    }
    function isBartender() {
      return isSignedIn()
        && 'role' in request.auth.token
        && request.auth.token.role in ['admin', 'bartender'];
    }
    function isStaffMember() {
      return isSignedIn()
        && 'role' in request.auth.token
        && request.auth.token.role in ['admin', 'bartender', 'staff'];
    }

    // DRINKS — lettura pubblica (clienti vedono il menù), scrittura solo bartender.
    match /drinks/{drinkId} {
      allow read: if true;
      allow write: if isBartender();
    }

    // ORDERS — i clienti creano e leggono; il bartender aggiorna qualsiasi
    // cosa; lo staff può solo portare un ordine da "pronto" a
    // "ritirato" (servizio al tavolo). Il cliente (non autenticato, in
    // possesso dell'id ordine) può modificare o annullare l'ordine SOLO
    // finché è "ricevuto": può lasciarlo "ricevuto" (modifica item) o
    // portarlo ad "annullato". Non può farlo avanzare di stato.
    match /orders/{orderId} {
      // Campi di pagamento: scritti da Cloud Functions (Admin SDK) e da
      // bartender/staff — mai dal cliente anonimo, che altrimenti
      // potrebbe auto-marcarsi "pagato".
      function paymentKeys() {
        return ['payment_status', 'payment_method', 'payment_required',
                'paid_at', 'sumup_checkout_id', 'sumup_checkout_attempts',
                'sumup_transaction_id', 'sumup_client_transaction_id',
                'payment_after_cancel', 'payment_id',
                'payments', 'discount', 'discount_amount',
                'sumup_pending_amount', 'sumup_pending_items',
                'invoice_id', 'invoice_number'];
      }
      allow read: if true;
      // Alla creazione il pagamento può solo essere assente, non
      // richiesto o in attesa (mai già "pagato").
      allow create: if isStaffMember()
        || !('payment_status' in request.resource.data)
        || request.resource.data.payment_status in ['non_richiesto', 'in_attesa'];
      // Modello conto/comande: il flusso di lavorazione vive sulle comande
      // (array nel doc), quindi le transizioni fini sono validate in app.
      // Lo staff (ruolo fidato via claims) può aggiornare gli ordini
      // (serve/incassa le comande); il cliente anonimo solo finché il conto
      // ha la sola prima comanda ancora "ricevuta", senza toccare i campi
      // di pagamento, e può al più annullare.
      allow update: if isStaffMember()
        || (resource.data.status in ['aperto', 'ricevuto']
            && (!('comande' in resource.data)
                || (resource.data.comande.size() == 1
                    && resource.data.comande[0].status == 'ricevuto'))
            && request.resource.data.status in ['aperto', 'ricevuto', 'annullato']
            && !request.resource.data.diff(resource.data)
                 .affectedKeys().hasAny(paymentKeys().toSet()));
      allow delete: if false;
    }

    // COUNTERS — scritti dalla transazione di creazione ordine (lato client, non autenticato).
    match /counters/{dateKey} {
      allow read: if true;
      allow write: if true;
    }

    // SERVIZIO PERPETUO — niente più "serate". Statistiche tempi (ETA):
    // lettura pubblica (il cliente vede la stima), scrittura dello staff
    // limitata ai campi statistici.
    match /service_stats/{docId} {
      allow read: if true;
      allow create, delete: if isBartender();
      allow update: if isBartender()
        || (isStaffMember()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['eta_stats', 'prep_stats']));
    }

    // CATEGORIES — lettura pubblica (il menù raggruppa per categoria), scrittura bartender.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isBartender();
    }

    // SETTINGS — lettura pubblica (i clienti vedono la modalità menù, coperto…), scrittura bartender.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isBartender();
    }

    // INVENTORY — solo bartender (non serve al cliente né allo staff).
    match /inventory_items/{itemId} {
      allow read, write: if isBartender();
    }

    // CATEGORIE INVENTARIO — dedicate ai prodotti di magazzino, solo bartender.
    match /inventory_categories/{categoryId} {
      allow read, write: if isBartender();
    }

    // MACRO-CATEGORIE — raggruppano le categorie per i conti aggregati, solo bartender.
    match /macro_categories/{macroId} {
      allow read, write: if isBartender();
    }

    // FORNITORI — anagrafica fornitori di magazzino, solo bartender.
    match /suppliers/{supplierId} {
      allow read, write: if isBartender();
    }

    // STOCK MOVEMENTS — registro carico/scarico, solo bartender.
    match /stock_movements/{movementId} {
      allow read, write: if isBartender();
    }

    // CONTE DI MAGAZZINO — inventario periodico (dep/acq/rim→consumo).
    match /stock_counts/{countId} {
      allow read, write: if isBartender();
    }

    // ORDINI FORNITORE — generatore ordini e storico acquisti.
    match /purchase_orders/{orderId} {
      allow read, write: if isBartender();
    }

    // SCADENZARIO FORNITORI — documenti/proforma, pagato, note.
    match /supplier_invoices/{invoiceId} {
      allow read, write: if isBartender();
    }

    // STAFF CALLS — cerca-persone: il bartender chiama, lo staff risponde.
    match /staff_calls/{callId} {
      allow read: if isStaffMember();
      allow create, delete: if isBartender();
      allow update: if isStaffMember();
    }

    // STAFF_TOKENS — token push del dispositivo di ciascun membro dello
    // staff (per la chiamata cerca-persone): solo il proprietario.
    match /staff_tokens/{uid} {
      allow read, write: if isStaffMember() && request.auth.uid == uid;
    }

    // CUSTOMERS — profilo del cliente registrato: solo il proprietario
    // (e il bartender in lettura).
    match /customers/{uid} {
      allow read: if isBartender() || (isSignedIn() && request.auth.uid == uid);
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // GROUPS — contenitori di ordini. Lo staff gestisce tutto; il cliente
    // registrato può creare/aggiornare SOLO il proprio gruppo-cliente
    // (id == uid, kind 'customer', radice, senza sottogruppi).
    match /groups/{groupId} {
      allow read: if isStaffMember()
        || (isSignedIn() && resource.data.customer_uid == request.auth.uid);
      allow create: if isStaffMember()
        || (isSignedIn()
            && groupId == request.auth.uid
            && request.resource.data.kind == 'customer'
            && request.resource.data.customer_uid == request.auth.uid
            && request.resource.data.parent_group_id == null
            && request.resource.data.has_child_groups == false);
      allow update: if isBartender()
        || (isStaffMember()
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['kind', 'customer_uid'].toSet()))
        || (isSignedIn()
            && resource.data.kind == 'customer'
            && resource.data.customer_uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['name', 'status', 'last_order_at'].toSet()));
      allow delete: if isBartender();
    }

    // PAYMENTS — registro incassi (ledger). Scrivibile dallo staff e dalle
    // Cloud Functions (Admin SDK, per i pagamenti online). Mai dal cliente.
    // RAPP ORE: registro ore dello staff — solo staff autenticato.
    match /staff_hours/{entryId} {
      allow read, write: if isStaffMember();
    }

    // PREFERENZE POS (ordine card, preferiti): configurazione del banco,
    // gestita dallo staff. Condivisa fra i dispositivi del locale.
    match /pos_prefs/{docId} {
      allow read, write: if isStaffMember();
    }

    // PAGHE: tariffa oraria per persona (storicizzata). Dato sensibile:
    // solo il bartender, nemmeno lo staff vede quanto prendono gli altri.
    match /staff_rates/{personId} {
      allow read, write: if isBartender();
    }

    // BADGE VIRTUALE: timbrature entrata/uscita — lo staff timbra sé
    // stesso al login/logout; il bartender può correggere ogni voce.
    match /staff_shifts/{shiftId} {
      allow read: if isStaffMember();
      allow create, update: if isStaffMember();
      allow delete: if isBartender();
    }

    // BUONI VIP: credito ricaricabile — solo staff (contiene i nomi VIP).
    match /vouchers/{voucherId} {
      allow read, write: if isStaffMember();
    }

    // FATTURE di cortesia: solo staff (contengono dati dei clienti).
    match /invoices/{invoiceId} {
      allow read, write: if isStaffMember();
    }

    match /payments/{paymentId} {
      allow read: if isStaffMember();
      allow create, update: if isStaffMember();
      allow delete: if false;
    }

    // CASSA: sessioni di apertura/chiusura serata (flusso cassa). Staff.
    match /cash_sessions/{sessionId} {
      allow read: if isStaffMember();
      allow create, update: if isStaffMember();
      allow delete: if false;
    }
  }
}
