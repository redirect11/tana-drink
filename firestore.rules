rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // DRINKS — lettura pubblica (clienti vedono il menù), scrittura solo bartender autenticato.
    match /drinks/{drinkId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ORDERS — i clienti creano e leggono; il bartender (autenticato) aggiorna lo stato.
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // COUNTERS — scritti dalla transazione di creazione ordine (lato client, non autenticato).
    match /counters/{dateKey} {
      allow read: if true;
      allow write: if true;
    }
  }
}
