rules_version = '2';

// =====================================================================
//  La Tana del Coniglio — Regole di sicurezza Cloud Firestore
// =====================================================================
//  Equivalente delle vecchie policy RLS di Supabase.
//  NB: per semplicità (locale senza login) le regole sono permissive.
//  In produzione valuta di restringere update/delete degli ordini e la
//  scrittura del menù a un bartender autenticato (Firebase Auth).
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // DRINKS — menù / ricette: lettura pubblica, scrittura consentita
    // (backoffice senza login).
    match /drinks/{drinkId} {
      allow read: if true;
      allow write: if true;
    }

    // ORDERS — i clienti creano e leggono ordini; il bartender li aggiorna.
    // Niente delete dal client.
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    // COUNTERS — contatori per la numerazione progressiva giornaliera.
    // Letti/scritti dalla transazione di creazione ordine.
    match /counters/{dateKey} {
      allow read: if true;
      allow write: if true;
    }
  }
}
