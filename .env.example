# URL e chiave pubblica (anon) del tuo progetto Supabase.
# Copia questo file in `.env` e inserisci i valori reali.
# La chiave anon è pubblica per design (protetta da Row Level Security).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=******

# PIN usato per accedere al backoffice bartender (lato client, non è una vera password).
VITE_BARTENDER_PIN=2468
