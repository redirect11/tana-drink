# Ambiente locale con gli emulatori: valori finti di un progetto "demo-*"
# che gira offline. Sta nel repo apposta, così chi arriva avvia e basta.
!.env.locale
# Config (vuota) delle Functions: serve in CI per il deploy non-interattivo.
# NON contiene segreti (i valori reali SumUp vanno nei secret Firebase).
!functions/.env

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# Firebase
.firebase
firebase-debug.log
*-debug.log

# Test coverage
coverage

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Export CSV del POS (snapshot dati, non vanno in git)
carte_*.csv

