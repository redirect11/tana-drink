# =====================================================================
#  I TEST DI SISTEMA (REQ-DEV-018, fase 2): l'app COMPILATA, con Auth e
#  Firestore emulati, guidata da Playwright.
#
#    npm run test:sistema
#
#  Come .env.locale, ma con Firestore sulla 8081 di firebase.collaudo.json:
#  è la configurazione che usano anche le prove delle regole, in locale e in
#  CI. Niente di segreto: il progetto «demo-*» vive solo sul computer che
#  fa girare le prove.
# =====================================================================
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_PROJECT_ID=demo-tana-drink
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-tana-drink.firebaseapp.com
VITE_FIRESTORE_EMULATOR_HOST=localhost
VITE_FIRESTORE_EMULATOR_PORT=8081
VITE_APP_ENV=test
