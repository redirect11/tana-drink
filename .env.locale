# =====================================================================
#  AMBIENTE LOCALE "come il server": app COMPILATA servita dall'emulatore
#  Hosting, con Auth, Firestore, Storage e Functions emulati.
#
#    npm run locale     → compila con questi valori e avvia tutto
#
#  Qui dentro non c'è niente di segreto: il progetto "demo-*" degli
#  emulatori gira offline e non tocca nessun database vero. Per questo il
#  file sta nel repo, a differenza di .env — chi arriva nuovo deve poter
#  avviare l'ambiente senza chiedere niente a nessuno.
# =====================================================================
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_PROJECT_ID=demo-tana-drink
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-tana-drink.firebaseapp.com
VITE_FIRESTORE_EMULATOR_HOST=localhost
VITE_FIRESTORE_EMULATOR_PORT=8080

# Nastro "TEST" e strumenti da sviluppatore accesi: è un ambiente di prova
# e deve dirlo, altrimenti si finisce per crederci.
VITE_APP_ENV=test
