rules_version = '2';

// Regole Firebase Storage per Tana Drink.
service firebase.storage {
  match /b/{bucket}/o {
    // Il ruolo vive nei custom claims del token, come in firestore.rules:
    // 'admin' e 'bartender' sono il backoffice, tutto il resto è cliente.
    function isBartender() {
      return request.auth != null
        && 'role' in request.auth.token
        && request.auth.token.role in ['admin', 'bartender'];
    }

    // LO STORAGE SEGUE LA LICENZA (REQ-SIC-006). Col Free col profilo
    // completo lo Storage c'è anche dove il piano non lo comprende, e l'app
    // che nasconde le foto non basta: chiamandolo a mano un admin di un Free
    // caricava foto a spese di Stonebit. La licenza si legge da Firestore
    // con la stessa domanda di firestore.rules (licenzaValida, alFree,
    // modulo): se cambia là, cambia qui — tests/regole/storage.test.js
    // prova i casi.
    // PREREQUISITO: il service agent dello Storage del progetto deve avere
    // `roles/firebaserules.firestoreServiceAgent`, se no la lettura fallisce
    // e non si carica più niente (REQ-SIC-006).
    // Solo i caricamenti la chiedono: leggere e cancellare restano, perché
    // un locale fermo deve poter vedere i suoi documenti e fare pulizia.
    function licenzaScritta() {
      return firestore.exists(/databases/(default)/documents/licenza/attuale);
    }
    function licenza() {
      return firestore.get(/databases/(default)/documents/licenza/attuale).data;
    }
    function scaduta() {
      let fino = licenza().get('valida_fino_ts', null);
      return fino is timestamp && request.time >= fino;
    }
    function alFree() {
      return scaduta() && licenza().get('alla_scadenza', 'ferma') == 'free';
    }
    function licenzaValida() {
      return licenzaScritta()
        && !(licenza().get('stato', 'attiva') in ['sospesa', 'chiusa', 'non_attivata'])
        && (!scaduta() || alFree());
    }
    function modulo(id) {
      return licenzaValida() && !alFree() && licenza().get('moduli', {}).get(id, false) == true;
    }
    // Le foto, come l'app (limiti.js, `fotoConsentite`): non sul Free, né
    // scritto (`piano: 'free'`) né arrivato per scadenza.
    function fotoConsentite() {
      return licenzaValida() && !alFree() && licenza().get('piano', '') != 'free';
    }

    // Foto dei drink: lettura pubblica (mostrate nel menù cliente).
    // CARICARE E CANCELLARE È DEL BANCO, non di chiunque abbia un account
    // (BUG-160): i clienti si registrano, e con `request.auth != null` un
    // cliente caricava file da 5 MB a spese del locale e cancellava le foto
    // del menù. La foto la mette solo la scheda prodotto, e il prodotto lo
    // scrivono banco e admin (firestore.rules, `drinks`).
    match /drinks/{file} {
      allow read: if true;
      allow delete: if isBartender();
      // Solo immagini, sotto i 5 MB.
      allow create, update: if isBartender()
                            && fotoConsentite()
                            && request.resource.size < 5 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
    }

    // Allegati dei documenti fornitore (scadenzario, REQ-MAG-033): la foto o
    // il PDF della fattura. NON SONO ROBA PUBBLICA come le foto dei drink:
    // sono documenti contabili del locale, e il permesso è lo stesso che
    // hanno le fatture in Firestore — `supplier_invoices` è riservata al
    // bartender/admin, e la carta di quel documento non può essere più
    // aperta del documento stesso. Una cartella per fattura, così il file si
    // sa sempre di chi è.
    //
    // ATTENZIONE, e va saputo: l'app apre l'allegato con il download URL
    // (`getDownloadURL`), che porta un token e vale per chiunque ce l'abbia.
    // Quel link però sta scritto SOLO dentro il documento della fattura, che
    // queste regole e quelle di Firestore proteggono: per averlo bisogna già
    // poter leggere la fattura. Sostituire o togliere l'allegato cancella il
    // file, e con lui il token.
    match /fatture/{invoiceId}/{file} {
      allow read, delete: if isBartender();
      // 8 MB: lo stesso numero di PESO_MASSIMO in src/lib/allegati.js, dove
      // è spiegato il perché. QUI c'è il limite vero — quello nell'app serve
      // a dirlo prima, invece di far fallire un caricamento già partito.
      // Il modulo è quello della collezione delle fatture in firestore.rules.
      allow create, update: if isBartender()
                            && (modulo('scadenzario') || modulo('magazzino'))
                            && request.resource.size < 8 * 1024 * 1024
                            && (request.resource.contentType.matches('image/.*')
                                || request.resource.contentType == 'application/pdf');
    }

    // Tutto il resto è negato di default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
