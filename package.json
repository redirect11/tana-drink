{
  "name": "karaoke-drink",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "App per la prenotazione dei drink del cocktail bar La Tana del Coniglio",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "requirements:issues": "node scripts/generate-issues.mjs",
    "seed": "node scripts/seed.js",
    "emulators": "firebase emulators:start --project demo-tana-drink --only firestore"
  },
  "dependencies": {
    "firebase": "^12.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.8"
  }
}
