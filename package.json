{
  "name": "karaoke-drink",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "App per la prenotazione dei drink del cocktail bar La Tana del Coniglio",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "TZ=Europe/Rome vitest run",
    "test:watch": "TZ=Europe/Rome vitest",
    "test:coverage": "TZ=Europe/Rome vitest run --coverage",
    "requirements:issues": "node scripts/generate-issues.mjs",
    "seed": "node scripts/seed.js",
    "seed:dev": "VITE_USE_FIREBASE_EMULATOR=true VITE_FIREBASE_PROJECT_ID=demo-tana-drink VITE_FIRESTORE_EMULATOR_HOST=localhost VITE_FIRESTORE_EMULATOR_PORT=8080 node scripts/seed.js",
    "mock:orders": "VITE_FIREBASE_PROJECT_ID=demo-tana-drink VITE_FIRESTORE_EMULATOR_HOST=localhost VITE_FIRESTORE_EMULATOR_PORT=8080 node scripts/mock-orders.js",
    "mock:history": "VITE_FIREBASE_PROJECT_ID=demo-tana-drink VITE_FIRESTORE_EMULATOR_HOST=localhost VITE_FIRESTORE_EMULATOR_PORT=8080 node scripts/mock-history.js",
    "emulators": "firebase emulators:start --project demo-tana-drink --only auth,firestore,storage"
  },
  "dependencies": {
    "firebase": "^12.14.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "vanilla-cookieconsent": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "firebase-admin": "^13.10.0",
    "globals": "^15.9.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.8"
  }
}
