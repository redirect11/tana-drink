# Valori NON segreti delle Functions per il progetto tana-drink (la Tana in
# produzione). firebase-tools carica .env e poi .env.<projectId>: questi
# vincono su quelli di .env. REQ-VENUE-005: il nome del locale e l'app id
# SumUp della Tana stanno qui, non nel codice.
VENUE_NAME=La Tana del Coniglio
SUMUP_AFFILIATE_APP_ID=it.latanadelconiglio.drink
# REGIA_PROGETTO (l'AI, REQ-AI-003). L'account ai-locale e il permesso di
# deploy ci sono dal 12/11/2026 (run 43295988436 della regia; il 14/11
# verificato con gcloud: firebase-adminsdk-fbsvc ha serviceAccountUser su
# ai-locale@tana-drink, quindi il deploy delle Functions non si ferma su
# actAs). La regia di produzione (0.3.0) riconosce il gettone col
# destinatario `regia-ai:drink-regia` dal 14/11/2026, quando ha detto che è
# pronta. L'AI risponde solo dopo che dal backoffice della regia la si
# accende e le si dà credito: prima, 402.
REGIA_PROGETTO=drink-regia
