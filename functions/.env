# Configurazione runtime delle Firebase Functions.
#
# Valori VUOTI = integrazione SumUp disattivata: le functions vengono
# deployate ma restano no-op (isSumUpConfigured() ritorna false).
#
# Questo file serve anche a far passare il deploy non-interattivo: senza un
# valore (anche vuoto) per queste variabili, `firebase deploy` in CI si blocca
# chiedendole a tastiera.
#
# Per ATTIVARE SumUp NON mettere qui il Vendor-Id reale (finirebbe nel repo):
# usa i secret -> `firebase functions:secrets:set SUMUP_VENDOR_ID` ecc.
SUMUP_VENDOR_ID=
SUMUP_OUTLET_ID=
